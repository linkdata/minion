[Unit]
Description=linkdataminion GitHub mention monitor

[Service]
Type=simple
# Let Minion cancel direct commands before systemd's shutdown timeout.
KillMode=mixed
WorkingDirectory=/path/to/minion
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/var/tmp
ExecStart=/path/to/minion/bin/minion -config /path/to/minion/config.local.json
Restart=always
RestartSec=30s
UMask=0077

[Install]
WantedBy=default.target
