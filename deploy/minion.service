[Unit]
Description=linkdataminion GitHub mention monitor

[Service]
Type=simple
# Let Minion cancel active model/Git process groups on shutdown.
KillMode=mixed
Delegate=yes
DelegateSubgroup=minion-supervisor
TasksMax=256
MemoryMax=4G
MemorySwapMax=0
WorkingDirectory=/path/to/minion
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/path/to/minion/bin/minion -config /path/to/minion/config.local.json -loop
Restart=always
RestartSec=30s
UMask=0077

[Install]
WantedBy=default.target
